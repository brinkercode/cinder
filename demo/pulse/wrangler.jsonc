{
  "name": "pulse",
  "main": "src/index.js",
  "compatibility_date": "2026-10-01",
  "triggers": { "crons": ["*/5 * * * *"] },
  "vars": { "TARGETS": "https://example.com" },
  "d1_databases": [{ "binding": "DB", "database_name": "pulse-db", "migrations_dir": "migrations" }],
  "kv_namespaces": [{ "binding": "CACHE" }]
}
