{
  "name": "web-store",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  "assets": { "directory": "public", "binding": "ASSETS" },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "web-store",
      // Placeholder: infra-cloudflare-tf fills in the real id when it is applied.
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations"
    }
  ]
}
