{
  "secrets_store_secrets": [{ "binding": "MERGE_SIGNING_KEY", "store_id": "00000000000000000000000000000000", "secret_name": "cinder_merge_signing_key" }],
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "cinder",
  "main": "src/index.js",
  // The seed's sources, bundled as data for the SeedWorkflow (src/admin.js).
  "build": { "command": "node ../seed/bundle.mjs" },
  // Version preview hosts sit outside the Access app, so they stay off.
  "preview_urls": false,
  "compatibility_date": "2026-10-03",
  "compatibility_flags": ["nodejs_compat"], // @cloudflare/ci
  "vars": { "AI_GATEWAY_ID": "cinder", "CF_ACCOUNT_ID": "00000000000000000000000000000000","CINDER_ENV": "nonprod" },
  // Flow step logs live in cinder-logs (D1 rows hold only the object key); runner toolchains are cached in cinder-ci-cache.
  "r2_buckets": [{ "binding": "LOGS", "bucket_name": "cinder-logs" }, { "binding": "TOOL_CACHE", "bucket_name": "cinder-ci-cache" }],
  "containers": [{ "class_name": "WorkerLite", "image": "../runner/Dockerfile", "instance_type": "lite", "max_instances": 20, "observability": { "logs": { "enabled": true } } }, { "class_name": "WorkerBasic", "image": "../runner/Dockerfile", "instance_type": "basic", "max_instances": 20, "observability": { "logs": { "enabled": true } } }, { "class_name": "WorkerStandard", "image": "../runner/Dockerfile.full", "instance_type": "standard-2", "max_instances": 20, "observability": { "logs": { "enabled": true } } }, { "class_name": "WorkerStandard4", "image": "../runner/Dockerfile.full", "instance_type": "standard-4", "max_instances": 20, "observability": { "logs": { "enabled": true } } }],
  // Workers Logs + traces; Workflows run in this Worker so they inherit it, containers set their own (they do not inherit).
  "observability": { "enabled": true, "logs": { "enabled": true, "invocation_logs": true, "head_sampling_rate": 1 }, "traces": { "enabled": true, "head_sampling_rate": 1 } },
  "assets": { "directory": "../web/dist", "not_found_handling": "single-page-application", "run_worker_first": ["/api/*"] },
  "d1_databases": [{ "binding": "DB", "database_name": "cinder", "database_id": "00000000-0000-0000-0000-000000000000", "migrations_dir": "migrations" }],
  "artifacts": [{ "binding": "ARTIFACTS", "namespace": "cinder" }],
  "ai": { "binding": "AI" },
  // Keystore and webhook secret values, read through cinder-secrets (secrets/), which holds their bindings (keystore.js rebind).
  "services": [{ "binding": "SECRETS", "service": "cinder-secrets" }],
  // Insights events (src/changes.js), read back through the Analytics Engine SQL API (src/insights.js).
  "analytics_engine_datasets": [{ "binding": "INSIGHTS", "dataset": "cinder_insights" }],
  // Advisories embedded by the cron (src/mirror.js ingestAdvisories); deploy/reconcile.sh creates the index.
  "vectorize": [{ "binding": "VULN_INDEX", "index_name": "cinder-vulns" }],
  "queues": { "producers": [{ "binding": "EVENTS", "queue": "cinder-events" }, { "binding": "WEBHOOKS", "queue": "cinder-webhooks" }], "consumers": [{ "queue": "cinder-events", "dead_letter_queue": "cinder-events-dlq" }, { "queue": "cinder-webhooks", "max_retries": 5, "dead_letter_queue": "cinder-webhooks-dlq" }] },
  "workflows": [{ "binding": "PIPELINE", "name": "cinder-pipeline", "class_name": "PipelineWorkflow" }, { "binding": "RESET", "name": "cinder-reset", "class_name": "ResetWorkflow" }, { "binding": "SEED", "name": "cinder-seed", "class_name": "SeedWorkflow" }],
  // Every push in the namespace starts the pipeline Workflow (artifacts/guides/build-and-deploy-on-push); the cron runs the drift check (src/drift.js).
  "triggers": { "events": [{ "type": "cf.artifacts.repo.pushed", "filter": { "namespace": "cinder" }, "targets": [{ "type": "workflow", "workflow_name": "cinder-pipeline" }] }], "crons": ["*/10 * * * *"] },
  "ratelimits": [{ "name": "CLAIM_LIMIT", "namespace_id": "1001", "simple": { "limit": 60, "period": 60 } }, { "name": "CHANGE_LIMIT", "namespace_id": "1002", "simple": { "limit": 30, "period": 60 } }, { "name": "PREVIEW_LIMIT", "namespace_id": "1003", "simple": { "limit": 30, "period": 60 } }],
  "durable_objects": { "bindings": [{ "name": "REPO_DO", "class_name": "RepoDO" }, { "name": "CHANGE_DO", "class_name": "ChangeDO" }, { "name": "DISPATCH_DO", "class_name": "DispatchDO" }, { "name": "WORKER_LITE", "class_name": "WorkerLite" }, { "name": "WORKER_BASIC", "class_name": "WorkerBasic" }, { "name": "WORKER_STANDARD", "class_name": "WorkerStandard" }, { "name": "WORKER_STANDARD4", "class_name": "WorkerStandard4" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["RepoDO"] }, { "tag": "v2", "new_sqlite_classes": ["ChangeDO"] }, { "tag": "v3", "new_sqlite_classes": ["DispatchDO"] }, { "tag": "v4", "new_sqlite_classes": ["CiSandbox"] }, { "tag": "v5", "new_sqlite_classes": ["WorkerLite", "WorkerBasic", "WorkerStandard"] }, { "tag": "v6", "new_sqlite_classes": ["WorkerStandard4"] }, { "tag": "v7", "deleted_classes": ["CiSandbox"] }]
}
